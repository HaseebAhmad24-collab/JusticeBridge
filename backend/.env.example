# ============================================
# JusticeBridge Backend — Environment Variables
# Copy this to your deployment platform dashboard
# DO NOT commit actual values to git
# ============================================

# AI
GEMINI_API_KEY=your_gemini_api_key_here

# Auth
GOOGLE_CLIENT_ID=your_google_client_id_here
SECRET_KEY=generate_a_strong_random_32char_key_here

# Email (Gmail SMTP)
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465

# IMPORTANT: Set this to your deployed frontend URL
FRONTEND_URL=https://your-frontend.vercel.app
