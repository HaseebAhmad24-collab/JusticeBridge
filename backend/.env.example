# ============================================
# JusticeBridge Backend — Environment Variables
# Copy this to your deployment platform dashboard
# DO NOT commit actual values to git
# ============================================

# AI
GEMINI_API_KEY=your_gemini_api_key_here

# Auth
GOOGLE_CLIENT_ID=your_google_client_id_here
SECRET_KEY=generate_a_strong_random_32char_key_here

# Email (Gmail SMTP)
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_SERVER=smtp.gmail.com
# 465 = SSL (works locally). On some cloud hosts (e.g. Render) port 465 is
# blocked/dropped outbound — if verification emails hang or never arrive
# in production, switch this to 587 (STARTTLS) on that platform's env vars only.
SMTP_PORT=465
# Max seconds to wait for the SMTP connection before giving up (prevents hangs)
SMTP_TIMEOUT=10

# IMPORTANT: Set this to your deployed frontend URL
FRONTEND_URL=https://your-frontend.vercel.app
