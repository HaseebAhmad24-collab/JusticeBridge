# ============================================
# JusticeBridge Backend — Environment Variables
# Copy this to your deployment platform dashboard
# DO NOT commit actual values to git
# ============================================

# AI
GEMINI_API_KEY=your_gemini_api_key_here

# Auth
GOOGLE_CLIENT_ID=your_google_client_id_here
SECRET_KEY=generate_a_strong_random_32char_key_here

# Email (Resend — sent over HTTPS, works locally and on hosts like Render
# that block outbound raw SMTP). Get a free API key at https://resend.com
RESEND_API_KEY=your_resend_api_key_here
# Default sender works immediately with no domain setup. Once you verify
# your own domain on Resend, you can switch this to your own address.
EMAIL_FROM=JusticeBridge AI <onboarding@resend.dev>

# IMPORTANT: Set this to your deployed frontend URL
FRONTEND_URL=https://your-frontend.vercel.app
